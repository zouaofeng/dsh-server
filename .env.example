# ===== 服务 =====
# 监听地址（仅 python -m app.main 启动时生效；uvicorn 命令行启动以命令行参数为准）
HOST=0.0.0.0
# 监听端口（同上）；docker compose 部署时是宿主机上发布的端口
PORT=8080
# 日志级别：DEBUG / INFO / WARNING / ERROR
LOG_LEVEL=INFO
# 服务鉴权用的 Bearer Token，多个用英文逗号分隔；留空表示不鉴权
# HTTP 通过 Authorization: Bearer <token> 传入；WebSocket 可用该请求头或 ?token=<token>
# 每个 token 有独立的会话空间（建议每人一个 token）；更换 token 后，旧 token 下的会话无法再通过接口访问
SERVICE_API_KEY=

# ===== 模型 / 凭据 =====
# DeepSeek API Key（必填）
DEEPSEEK_API_KEY=sk-your-key-here
# 可选，兼容 DeepSeek 的接口地址或代理地址；留空使用官方地址
DEEPSEEK_BASE_URL=
# 模型提供方路由，默认 deepseek-official
DSH_PROVIDER=deepseek-official
# 模型名称
DSH_MODEL=deepseek-v4-flash
# 可选，推理强度，取值由适配器定义（如 high / max）；留空使用模型默认值
DSH_REASONING_EFFORT=
# 可选，单次请求输出的 token 上限；留空使用 provider 默认值
DSH_MAX_TOKENS=

# ===== Harness 运行时 =====
# 使用的 profile：sdk（完整工具集）| sdk-minimal（仅持久 shell，权限固定为 danger-full-access）| 自定义 profile 名称
DSH_PROFILE=sdk
# 独立的 Harness home 目录，存放 profile、插件和 sessions/*.jsonl 会话日志；不会读取 ~/.dsh
DSH_HOME=./data/home
# Agent 的工作目录，建议使用一次性目录或容器
DSH_WORKSPACE=./data/workspace
# 权限模式：read-only | workspace-write | danger-full-access（仅对 sdk profile 生效）
# 服务没有人工审批通道，需要审批的操作会被自动拒绝
DSH_PERMISSION_MODE=workspace-write
# 可选，指定其他 dsh 可执行文件；留空使用 SDK 自带的运行时
DSH_BIN=
# 是否关闭“随模型请求把会话日志上传给 DeepSeek”；true 表示关闭上传（默认）
DISABLE_SESSION_LOG_UPLOAD=true
# 额外 cordis patch 文件路径，多个用英文逗号分隔；相对路径以启动服务时的当前目录为准（容器内为 /app）
# 接入 MCP 服务：复制 patches/mcp.example.patch.yml 为 patches/mcp.patch.yml，修改后填 patches/mcp.patch.yml
# Docker 部署时，patches/ 在构建时打进镜像，修改后需重新构建；也可以放到 DATA_DIR 下，填 /app/data/<文件名>
DSH_EXTRA_PATCHES=
# patch 中用 !!js process.env.XXX 引用的密钥（例如 MCP 服务的 token）：
# Docker 部署时直接写在本文件中即可；本地运行时本文件不会导出到环境变量，需要在启动服务的 shell 中 export
# REMOTE_DEMO_MCP_TOKEN=

# 运行时启动和初始化握手的超时时间（秒）
INITIALIZE_TIMEOUT_SECONDS=60
# session/prompt JSON-RPC 请求的超时时间（秒）；留空表示不限制
REQUEST_TIMEOUT_SECONDS=
# 单个任务的总时长上限（秒），超时后重启运行时并返回 HTTP 504；留空表示不限制
RUN_TIMEOUT_SECONDS=

# ===== 调度 / 流式推送 =====
# 任务按顺序逐个执行；执行中和排队中的任务总数超过该值时拒绝新请求（HTTP 429）
MAX_PENDING_RUNS=8
# 没有事件时的心跳间隔（秒）：SSE 发送 ": ping" 注释行，WebSocket 发送 {"type":"ping"}
STREAM_HEARTBEAT_SECONDS=15
# 不推送给 SSE / WebSocket 客户端的 session.event 类型，多个用英文逗号分隔
STREAM_EXCLUDED_EVENT_TYPES=system/message,request/header

# ===== Docker Compose 部署（仅 docker compose 使用，本地运行时忽略） =====
# 容器内的 DSH_HOME / DSH_WORKSPACE 固定为 /app/data/home 和 /app/data/workspace，上面两项不生效
# 宿主机上挂载为 /app/data 的目录
DATA_DIR=./data
# 数据文件的属主，建议设为宿主机当前用户：id -u / id -g
APP_UID=1000
APP_GID=1000
# 构建镜像时使用的 PyPI 镜像源，留空使用 pypi.org，例如 https://mirrors.tencent.com/pypi/simple/
PIP_MIRROR=
